# Copy to .env and fill in for your Freshdesk account.
#   cp .env.example .env
#
# The repo intentionally ships no account data, so every product/customer
# specific value lives here (and .env is gitignored).

# ---------------------------------------------------------------------------
# Required: the Freshdesk account to target.
# Either the canonical host, or a custom portal domain (auto-resolved to the
# canonical *.freshdesk.com host).
# ---------------------------------------------------------------------------
FD_SERVER=your-account.freshdesk.com

# ---------------------------------------------------------------------------
# Automated agent login (scripts/login.ts). Needed unless you authenticate
# with FD_API_KEY or FD_SESSION_COOKIE below.
# ---------------------------------------------------------------------------
FD_USER=agent@example.com
FD_PASSWORD=change-me
# Base32 TOTP seed used for two-factor authentication.
FD_TOTP_SEED=BASER32TOTPseedHERE

# ---------------------------------------------------------------------------
# Alternative authentication (either one is enough; both are optional).
# ---------------------------------------------------------------------------
# Personal API key from your Freshdesk profile settings.
# FD_API_KEY=your_api_key
#
# A session cookie captured from a signed-in browser session.
# FD_SESSION_COOKIE=user_credentials=...; _helpkit_session=...

# ---------------------------------------------------------------------------
# Account-specific product data. Regenerate both from the live API with:
#   bun run scripts/sync-products.ts
#
# Values are quoted because dotenvy drops unquoted values containing spaces
# (multi-word product names would otherwise be silently lost).
# ---------------------------------------------------------------------------

# The expected `_Components` catalog for this account. Used by
# test_upstream_components_schema_changes to flag added/removed/renamed
# products. The test skips when this is unset.
# FD_BASELINE_COMPONENTS="product-a,product-b"

# Products pre-checked under "In Charge" in generated quarterly reports.
# Comma-separated; when unset, no product is checked.
# FD_DEFAULT_IN_CHARGE_PRODUCTS="product-a,product-b"
